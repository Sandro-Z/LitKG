+"${compose[@]}" ps api worker_parse worker_extract
+if $retry_failed; then
+    python3 - <<'PY'
+import json,urllib.request
+base='http://127.0.0.1:8080'
+for document_id in range(25,30):
+    with urllib.request.urlopen(f'{base}/knowledge-bases/14/documents/{document_id}/processing',timeout=15) as response:
+        document=json.load(response)['document']
+    if document['status'] not in {'failed','partial'}:
