{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      },
      "required": [
        "nodes",
        "claims"
      ],
      "additionalProperties": false
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "ontology": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "node_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "predicates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "domain": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "range": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "domain",
                  "range"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "node_types",
            "predicates"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scope",
        "ontology"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "graph",
    "documents",
    "policy"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "block_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "supports",
            "contradicts",
            "context"
          ]
        }
      },
      "required": [
        "doc_id",
        "block_id",
        "start",
        "end",
        "quote",
        "role"
      ],
      "additionalProperties": false
    },
    "qualifiers": {
      "type": "object",
      "properties": {
        "negated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "modality": {
          "type": "string",
          "enum": [
            "asserted",
            "possible",
            "hypothetical",
            "unknown"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "negated",
        "modality",
        "context"
      ],
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "literal"
          ]
        },
        "value": {
          "type": "string"
        },
        "datatype": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "value",
        "datatype"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "label",
        "type",
        "aliases"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/value"
        },
        "qualifiers": {
          "$ref": "#/$defs/qualifiers"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "subject",
        "predicate",
        "object",
        "qualifiers",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "table",
            "figure_caption",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "id",
        "page",
        "section",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "parsing_status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unreadable"
          ]
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "required": [
        "id",
        "title",
        "version",
        "source_file",
        "source_sha256",
        "parsing_status",
        "blocks"
      ],
      "additionalProperties": false
    }
  }
}
